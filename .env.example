# このファイルをコピーして .env を作成する（.env は .gitignore 対象）
# cp .env.example .env

# --- Database (Postgres + PostGIS) ---
POSTGRES_DB=triplog
POSTGRES_USER=triplog
POSTGRES_PASSWORD=triplog
POSTGRES_PORT=5432

# --- MinIO (Cloudflare R2 代替) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_PHOTOS=triplog-photos
MINIO_BUCKET_TILES=triplog-tiles

# --- Claude API ---
ANTHROPIC_API_KEY=
AI_MOCK=true

# --- API ---
API_PORT=8080
API_DEBUG_PORT=5005

# --- Web ---
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8080
