# このファイルをコピーして .env を作成する（.env は .gitignore 対象）
# cp .env.example .env
#
# EXPO_PUBLIC_ プレフィックスの変数はExpoが自動でクライアントに埋め込む。
# iOSシミュレータはホストMacとネットワークを共有するため、docker composeで
# 公開された http://localhost:8080 にそのままアクセスできる。
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# MapLibreのスタイルJSON URL。本番/自宅サーバ用のPMTiles配置（Cloudflare R2/MinIO
# `triplog-tiles`バケット）はインフラ整備タスクとして別途行うため未設定。
# 未設定時はコード側でMapLibre公式の公開デモスタイル（https://demotiles.maplibre.org/style.json）
# にフォールバックする（ローカル開発用の暫定対応。S-001 plan.md「技術的リスク・懸念点」参照）。
# EXPO_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
